  "sequences": [
    {
      "id": "1",
      "name": "Theater Show · Manual GO",
      "loop": false,
      "steps": [
        {
          "text": "01 · Line check",
          "description": "Before opening the house. Check the six outlines against the set.",
          "actions": [
            {
              "snapshot": "1"
            },
            {
              "preset": "1"
            }
          ]
        },
        {
          "text": "02 · House out",
          "description": "On house clear. Hold the blackout until the performer is in place.",
          "snapshot": "2"
        },
        {
          "text": "03 · The archive",
          "description": "On the performer’s first step. Reveal the corridor from the floor upwards.",
          "snapshot": "3"
        },
        {
          "text": "04 · Power failure",
          "description": "On the hand touching the wall. The practicals fail and a line cuts through the shutters.",
          "actions": [
            {
              "snapshot": "4"
            },
            {
              "timeline": "1",
              "action": "play",
              "pre_wait": 0.15
            }
          ]
        },
        {
          "text": "05 · The wall parts",
          "description": "On the performer stepping back. The shutters slide apart to reveal a dark horizon.",
          "actions": [
            {
              "snapshot": "5"
            },
            {
              "preset": "2"
            }
          ]
        },
        {
          "text": "06 · First light",
          "description": "On the performer turning out. Let the sunrise reach the auditorium.",
          "snapshot": "6"
        },
        {
          "text": "07 · The last image",
          "description": "After the final line. Leave the horizon and take the archive away.",
          "snapshot": "7"
        },
        {
          "text": "08 · Final blackout",
          "description": "At the stage manager’s call. Fade out and hold.",
          "snapshot": "8"
        }
      ]
    }
  ],
